const servers = [
  { flag: "🇩🇪", country: "Германия", city: "Франкфурт", tier: "premium" },
  { flag: "🇳🇱", country: "Нидерланды", city: "Амстердам", tier: "premium" },
  { flag: "🇪🇪", country: "Эстония", city: "Таллин", tier: "free" },
  { flag: "🇫🇮", country: "Финляндия", city: "Хельсинки", tier: "premium" },
  { flag: "🇸🇪", country: "Швеция", city: "Стокгольм", tier: "premium" }
];

const users = {
  "demo-user-123": {
    name: "Demo User",
    plan: "premium",
    traffic_used: 5368709120,
    traffic_limit: 107374182400,
    expire: 1767225600
  }
};

module.exports = (req, res) => {
  const userId = req.query.id;
  const user = users[userId];

  if (!user) {
    return res.status(404).json({ error: 'User not found' });
  }

  const now = Math.floor(Date.now() / 1000);
  const daysLeft = Math.max(0, Math.floor((user.expire - now) / 86400));
  const gbUsed = (user.traffic_used / 1024 ** 3).toFixed(2);
  const gbTotal = (user.traffic_limit / 1024 ** 3).toFixed(2);
  const percent = ((user.traffic_used / user.traffic_limit) * 100).toFixed(1);

  const availableServers = servers.filter(s =>
    user.plan === 'premium' ? true : s.tier === 'free'
  );

  res.status(200).json({
    name: user.name,
    plan: user.plan,
    daysLeft,
    gbUsed,
    gbTotal,
    percent,
    servers: availableServers
  });
};
