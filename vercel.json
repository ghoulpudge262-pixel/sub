{
  "rewrites": [
    { "source": "/sub/:id", "destination": "/api/sub?id=:id" },
    { "source": "/stats/:id", "destination": "/api/stats?id=:id" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
